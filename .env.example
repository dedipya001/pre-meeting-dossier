NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgresql://dossier:dossier@localhost:5432/dossier
REDIS_URL=redis://localhost:6379
SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64-key
MOCK_PROVIDER_ENABLED=true
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
GMAIL_ENABLED=false
GMAIL_ACCESS_TOKEN=
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/google/callback
APP_JWT_SECRET=replace-with-a-long-random-secret
MCP_REQUIRE_AUTH=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
